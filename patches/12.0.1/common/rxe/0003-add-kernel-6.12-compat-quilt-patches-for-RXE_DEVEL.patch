From 8fee417050db4fd63d529d9af4522dd09c7e575c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Tiziano=20M=C3=BCller?= <tiziano.mueller@hpe.com>
Date: Wed, 1 Apr 2026 15:20:04 +0200
Subject: [PATCH] Add kernel 6.12 compatibility quilt patches for RXE_DEVEL
 target

Add four compatibility patches for building rxe-6.3 on kernel 6.12+:

- add_netmem_to_skb_frag_t: Replace direct bio_vec member access with
  skb_frag accessor functions (skb_frag_page, skb_frag_off, etc.)
- merge_tag_rcu: Replace removed single-arg kfree_rcu() with
  kfree_rcu_mightsleep()
- create_cq_attrs_bundle: Adapt rxe_create_cq() signature from
  ib_udata to uverbs_attr_bundle
- static_pick_tx: Add missing static qualifier to rxe_netdev_pick_tx
  and rxe_netdev_core_pick_tx

Also add devel.series to wire these patches into the quilt series
when compatibility_files includes devel.series.
---
 patches/compatibility/devel.series            |  4 +++
 .../devel/add_netmem_to_skb_frag_t.patch      | 34 +++++++++++++++++++
 .../devel/create_cq_attrs_bundle.patch        | 20 +++++++++++
 .../compatibility/devel/merge_tag_rcu.patch   | 17 ++++++++++
 .../compatibility/devel/static_pick_tx.patch  | 28 +++++++++++++++
 5 files changed, 103 insertions(+)
 create mode 100644 patches/compatibility/devel.series
 create mode 100644 patches/compatibility/devel/add_netmem_to_skb_frag_t.patch
 create mode 100644 patches/compatibility/devel/create_cq_attrs_bundle.patch
 create mode 100644 patches/compatibility/devel/merge_tag_rcu.patch
 create mode 100644 patches/compatibility/devel/static_pick_tx.patch

diff --git a/patches/compatibility/devel.series b/patches/compatibility/devel.series
new file mode 100644
index 0000000..422583c
--- /dev/null
+++ b/patches/compatibility/devel.series
@@ -0,0 +1,4 @@
+compatibility/devel/add_netmem_to_skb_frag_t.patch -p1
+compatibility/devel/merge_tag_rcu.patch -p1
+compatibility/devel/create_cq_attrs_bundle.patch -p1
+compatibility/devel/static_pick_tx.patch -p1
diff --git a/patches/compatibility/devel/add_netmem_to_skb_frag_t.patch b/patches/compatibility/devel/add_netmem_to_skb_frag_t.patch
new file mode 100644
index 0000000..900e722
--- /dev/null
+++ b/patches/compatibility/devel/add_netmem_to_skb_frag_t.patch
@@ -0,0 +1,34 @@
+This patch adapts the rxe driver for the netmem-based skb_frag_t
+introduced in kernel 6.1+. The old bio_vec members (bv_page,
+bv_offset, bv_len) are replaced with their accessor counterparts.
+
+diff --git a/rxe/rxe_mr.c b/rxe/rxe_mr.c
+index 488bd95..f4a9ae2 100644
+--- a/rxe/rxe_mr.c
++++ b/rxe/rxe_mr.c
+@@ -275,9 +275,7 @@
+ 		return -EINVAL;
+ 	}
+ 
+-	frag->bv_len = length;
+-	frag->bv_offset = offset;
+-	frag->bv_page = page;
++	skb_frag_fill_page_desc(frag, page, offset, length);
+ 	/* because kfree_skb will call put_page() */
+ 	get_page(page);
+ 	skb_shinfo(skb)->nr_frags++;
+diff --git a/rxe/rxe_icrc.c b/rxe/rxe_icrc.c
+index 43b5b42..dc7221e 100644
+--- a/rxe/rxe_icrc.c
++++ b/rxe/rxe_icrc.c
+@@ -165,8 +165,8 @@
+ 	/* handle any payload in frags */
+ 	for (i = 0; i < shinfo->nr_frags; i++) {
+ 		frag = &shinfo->frags[i];
+-		addr = page_to_virt(frag->bv_page) + frag->bv_offset;
+-		len = frag->bv_len;
++		addr = page_to_virt(skb_frag_page(frag)) + skb_frag_off(frag);
++		len = skb_frag_size(frag);
+ 		if (i == shinfo->nr_frags - 1) {
+ 			len -= RXE_ICRC_SIZE;
+ 			*icrcp = (__be32 *)(addr + len);
diff --git a/patches/compatibility/devel/create_cq_attrs_bundle.patch b/patches/compatibility/devel/create_cq_attrs_bundle.patch
new file mode 100644
index 0000000..cae34ca
--- /dev/null
+++ b/patches/compatibility/devel/create_cq_attrs_bundle.patch
@@ -0,0 +1,20 @@
+Adapt rxe_create_cq() to the new uverbs_attr_bundle signature
+introduced by kernel commit dd6d7f85 ("Pass entire attr bundle to
+create_cq", 2024-06-27).  The old ib_udata parameter is extracted
+from attrs->driver_udata for backward-compatible usage within the
+function body.
+
+diff --git a/rxe/rxe_verbs.c b/rxe/rxe_verbs.c
+index 4d8f6b80..97b3c1f0 100644
+--- a/rxe/rxe_verbs.c
++++ b/rxe/rxe_verbs.c
+@@ -1033,8 +1033,9 @@
+ /* cq */
+ static int rxe_create_cq(struct ib_cq *ibcq, const struct ib_cq_init_attr *attr,
+-			 struct ib_udata *udata)
++			 struct uverbs_attr_bundle *attrs)
+ {
++	struct ib_udata *udata = &attrs->driver_udata;
+ 	struct ib_device *dev = ibcq->device;
+ 	struct rxe_dev *rxe = to_rdev(dev);
+ 	struct rxe_cq *cq = to_rcq(ibcq);
diff --git a/patches/compatibility/devel/merge_tag_rcu.patch b/patches/compatibility/devel/merge_tag_rcu.patch
new file mode 100644
index 0000000..7cff5fe
--- /dev/null
+++ b/patches/compatibility/devel/merge_tag_rcu.patch
@@ -0,0 +1,17 @@
+Replace the single-argument kfree_rcu(mr) call with
+kfree_rcu_mightsleep(mr). The single-argument form was removed
+in kernel 6.x.
+
+diff --git a/rxe/rxe_verbs.c b/rxe/rxe_verbs.c
+index 4d8f6b80..83093e16 100644
+--- a/rxe/rxe_verbs.c
++++ b/rxe/rxe_verbs.c
+@@ -1324,7 +1324,7 @@
+ 
+ 	rxe_cleanup(mr);
+ 
+-	kfree_rcu(mr);
++	kfree_rcu_mightsleep(mr);
+ 	return 0;
+ 
+ err_out:
diff --git a/patches/compatibility/devel/static_pick_tx.patch b/patches/compatibility/devel/static_pick_tx.patch
new file mode 100644
index 0000000..28dc3f8
--- /dev/null
+++ b/patches/compatibility/devel/static_pick_tx.patch
@@ -0,0 +1,28 @@
+Add missing 'static' qualifier to rxe_netdev_pick_tx() and
+rxe_netdev_core_pick_tx().  These functions are only used within
+rxe_net.c but were missing static, causing -Wmissing-prototypes
+errors on kernel 6.12+ where the compiler enforces this more
+strictly.
+
+diff --git a/rxe/rxe_net.c b/rxe/rxe_net.c
+index 0a6f3e8..b2d4c91 100644
+--- a/rxe/rxe_net.c
++++ b/rxe/rxe_net.c
+@@ -436,7 +436,7 @@
+ 	return true;
+ }
+ 
+-u16 rxe_netdev_pick_tx(struct net_device *dev, struct sk_buff *skb,
++static u16 rxe_netdev_pick_tx(struct net_device *dev, struct sk_buff *skb,
+ 		       struct net_device *sb_dev)
+ {
+ 	if (skb_hash_to_txq)
+@@ -444,7 +444,7 @@
+ 	return netdev_pick_tx(dev, skb, sb_dev);
+ }
+ 
+-struct netdev_queue *rxe_netdev_core_pick_tx(struct net_device *dev,
++static struct netdev_queue *rxe_netdev_core_pick_tx(struct net_device *dev,
+ 					     struct sk_buff *skb,
+ 					     struct net_device *sb_dev)
+ {
-- 
