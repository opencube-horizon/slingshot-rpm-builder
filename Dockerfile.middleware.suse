# Dockerfile.middleware — Layered userland/middleware RPMs on top of SHS base packages
#
# Build context: the project directory
# Additional context: --build-context base-rpms=./RPMS.${SHS_VER}
#
# Usage:
#   docker buildx build -f Dockerfile.middleware \
#     --build-context base-rpms=./RPMS.14.0.1 \
#     --build-arg SHS_VER=14.0.1 \
#     --target rpms --output type=local,dest=./RPMS.middleware.14.0.1 .

# Stage 1: Build environment with SHS base RPMs installed
FROM registry.opensuse.org/opensuse/leap:16.0 AS buildenv

# Core build tools
# Workaround: openSUSE signing key expired 2026-06-19, disable RPM signature verification
RUN rpm -e --allmatches gpg-pubkey 2>/dev/null || true ; \
    echo "%_pkgverify_level none" > /etc/rpm/macros.nosig

RUN --mount=type=cache,target=/var/cache/zypp \
  set -ex ; \
  zypper --non-interactive --gpg-auto-import-keys refresh ; \
  zypper --non-interactive --no-gpg-checks up ; \
  zypper --non-interactive --no-gpg-checks install --recommends \
    -t pattern devel_{C_C++,rpm_build} ; \
  zypper --non-interactive --no-gpg-checks install \
    cmake \
    meson \
    ninja \
    gcc-fortran \
    boost-devel \
    fuse3-devel \
    libjson-c-devel \
    liblz4-devel \
    libuuid-devel \
    libyaml-devel \
    openssl-devel \
    python313-devel \
    python313-pip \
    python313-setuptools \
    python313-Cython \
    hwloc-devel \
    libnuma-devel \
    libevent-devel \
    pmix-devel \
    libnl3-devel \
    libcurl-devel \
    libselinux-devel \
    createrepo_c \
    curl \
    nasm \
    go \
    go-race \
    scons \
    protobuf-c-devel \
    libcapstone-devel \
    libcmocka-devel \
    valgrind-devel \
    cunit-devel \
    pciutils-devel \
    python3-distro \
    python-rpm-macros \
    lua-lmod \
    systemd-rpm-macros \
    distribution-release \
    libasan8 \
    ;

# Install base SHS RPMs (libfabric with CXI provider) from the pre-built repo
# Note: userland packages only need libfabric-devel (CXI is compiled into libfabric)
# libfabric/libcxi link against libnl3 and libcurl — install them for transitive linking
RUN --mount=type=bind,from=base-rpms,target=/tmp/base-rpms \
  set -ex ; \
  rpm -ivh --nodeps \
    /tmp/base-rpms/$(uname -m)/libfabric-[0-9]*.rpm \
    /tmp/base-rpms/$(uname -m)/libfabric-devel-[0-9]*.rpm \
    /tmp/base-rpms/$(uname -m)/cray-libcxi-[0-9]*.rpm \
    /tmp/base-rpms/$(uname -m)/cray-libcxi-devel-[0-9]*.rpm \
    /tmp/base-rpms/noarch/cassini-firmware-headers-*.rpm \
    /tmp/base-rpms/noarch/cray-cassini-headers-user-*.rpm \
    /tmp/base-rpms/$(uname -m)/cray-cxi-driver-devel-*.rpm \
    ;

WORKDIR /build
ARG CACHEBUST=1
COPY Makefile.middleware /build/
COPY specs/ /build/specs/

# Stage 2: Parallel build stacks — buildkit runs independent FROM stages concurrently.
# Each stack fetches its own sources and compiles independently.

# Stack 1: argobots + mercury (~30s)
FROM buildenv AS stack-mercury
ARG MAKEOPTS
RUN make -f Makefile.middleware stack-mercury ${MAKEOPTS}

# Stack 2: mpich 4.x + mpi4py-mpich (~200s)
FROM buildenv AS stack-mpich
ARG MAKEOPTS
RUN make -f Makefile.middleware stack-mpich ${MAKEOPTS}

# Stack 3: mpich 5.x (~200s)
FROM buildenv AS stack-mpich5
ARG MAKEOPTS
RUN make -f Makefile.middleware stack-mpich5 ${MAKEOPTS}

# Stack 4: openmpi + mpi4py-openmpi (~300s)
FROM buildenv AS stack-openmpi
ARG MAKEOPTS
RUN make -f Makefile.middleware stack-openmpi ${MAKEOPTS}

# Stage 3: Merge all RPMs and generate repo metadata
FROM buildenv AS assemble
COPY --from=stack-mercury /build/rpmbuild/RPMS/ /build/rpmbuild/RPMS/
COPY --from=stack-mpich /build/rpmbuild/RPMS/ /build/rpmbuild/RPMS/
COPY --from=stack-mpich5 /build/rpmbuild/RPMS/ /build/rpmbuild/RPMS/
COPY --from=stack-openmpi /build/rpmbuild/RPMS/ /build/rpmbuild/RPMS/
RUN createrepo /build/rpmbuild/RPMS

# Stage 4: Collect RPM artifacts into a minimal image
FROM scratch AS rpms
COPY --from=assemble /build/rpmbuild/RPMS/ /
