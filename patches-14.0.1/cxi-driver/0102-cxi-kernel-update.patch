+/*
+ * Compat: ida_simple_get/ida_simple_remove removed in Linux 6.4.
+ * Provide inline wrappers mapping to the current ida_alloc API.
+ */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 4, 0)
+#ifndef ida_simple_get
+static inline int __cxi_ida_simple_get(struct ida *ida, unsigned int start,
+				       unsigned int end, gfp_t gfp)
+{
+	if (end == 0)
+		return ida_alloc_min(ida, start, gfp);
+	return ida_alloc_range(ida, start, end - 1, gfp);
+}
+#define ida_simple_get __cxi_ida_simple_get
+
+static inline void __cxi_ida_simple_remove(struct ida *ida, unsigned int id)
+{
+	ida_free(ida, id);
+}
+#define ida_simple_remove __cxi_ida_simple_remove
+#endif
+#endif
