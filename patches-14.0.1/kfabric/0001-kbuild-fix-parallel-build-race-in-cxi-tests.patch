diff --git a/tests/cxi/multi_client/Makefile b/tests/cxi/multi_client/Makefile
index dd009bb..58d5ec4 100644
--- a/tests/cxi/multi_client/Makefile
+++ b/tests/cxi/multi_client/Makefile
@@ -1,11 +1,16 @@
 TOPDIR := $(src)/../../..
 TEST_COMMON_DIR := $(TOPDIR)/tests/cxi/common
-TEST_COMMON_LIB := ../common/test_common.o
 
 obj-m := multi-nic-msg.o
 
-multi-nic-msg-objs := multi_nic_msg.o $(TEST_COMMON_LIB)
+multi-nic-msg-objs := multi_nic_msg.o test_common.o
 
 ccflags-y += -I$(TOPDIR)/include -I$(TOPDIR)/../cxi-driver/include \
 	-I$(TOPDIR)/../cassini-headers/install/include \
 	-I$(TEST_COMMON_DIR)
+
+# Compile test_common.c from the common directory into this build directory
+# so that parallel builds of single_client/ and multi_client/ do not race
+# on a shared output file.
+$(obj)/test_common.o: $(src)/../common/test_common.c FORCE
+	$(call if_changed_rule,cc_o_c)
